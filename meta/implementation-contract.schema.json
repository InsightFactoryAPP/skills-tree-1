{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SamoTech/skills-tree/blob/main/meta/implementation-contract.schema.json",
  "title": "Skills Tree Universal Implementation Contract",
  "description": "Machine-readable contract for concrete realizations of canonical Skills.",
  "type": "object",
  "required": ["contract_version", "implementation"],
  "properties": {
    "contract_version": { "type": "string", "const": "1.0" },
    "implementation": { "$ref": "#/$defs/implementation" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*$", "minLength": 2 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "stringList": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "implementation": {
      "type": "object",
      "required": ["id", "version", "name", "skill", "type", "interface", "inputs", "outputs", "requirements", "constraints", "limitations", "provenance", "evidence", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/version" },
        "name": { "type": "string", "minLength": 1 },
        "skill": { "$ref": "#/$defs/id" },
        "type": { "type": "string", "enum": ["library", "api", "service", "tool", "runtime", "composite"] },
        "provider": { "type": ["string", "null"] },
        "interface": { "type": "string", "minLength": 1 },
        "inputs": { "$ref": "#/$defs/stringList" },
        "outputs": { "$ref": "#/$defs/stringList" },
        "requirements": { "$ref": "#/$defs/stringList" },
        "constraints": { "$ref": "#/$defs/stringList" },
        "limitations": { "$ref": "#/$defs/stringList" },
        "provenance": {
          "type": "object",
          "required": ["source_type"],
          "additionalProperties": false,
          "properties": {
            "source_type": { "type": "string", "enum": ["repository", "official_documentation", "implementation", "benchmark", "production", "community", "experimental"] },
            "source": { "type": "string", "minLength": 1 },
            "verified_at": { "type": "string", "format": "date-time" },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "methodology": { "type": "string" }
          }
        },
        "evidence": { "$ref": "#/$defs/stringList" },
        "status": { "type": "string", "enum": ["candidate", "verified", "deprecated", "experimental"] }
      }
    }
  }
}
