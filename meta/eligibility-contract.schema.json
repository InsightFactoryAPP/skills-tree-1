{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SamoTech/skills-tree/blob/main/meta/eligibility-contract.schema.json",
  "title": "Skills Tree Eligibility Contract",
  "description": "Machine-readable contract for deterministic pre-ranking candidate eligibility.",
  "type": "object",
  "required": ["contract_version", "request", "result"],
  "properties": {
    "contract_version": {"type": "string", "const": "1.0"},
    "request": {"$ref": "#/$defs/request"},
    "result": {"$ref": "#/$defs/result"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*$", "minLength": 2},
    "target": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": {"type": "string", "enum": ["platform", "framework", "model", "protocol", "runtime"]},
        "id": {"$ref": "#/$defs/id"}
      },
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "required": ["candidates"],
      "properties": {
        "candidates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "target": {"anyOf": [{"$ref": "#/$defs/target"}, {"type": "null"}]}
      },
      "additionalProperties": false
    },
    "reason": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "enum": ["missing_candidate", "no_implementation", "compatibility_missing", "compatibility_conditional", "compatibility_incompatible", "compatibility_deprecated"]},
        "message": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": ["id", "status", "reasons"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "status": {"type": "string", "enum": ["eligible", "conditional", "ineligible"]},
        "reasons": {"type": "array", "items": {"$ref": "#/$defs/reason"}}
      },
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "required": ["candidates"],
      "properties": {
        "candidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}}
      },
      "additionalProperties": false
    }
  }
}